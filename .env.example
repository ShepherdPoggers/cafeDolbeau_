# Configuration de développement commune à Docker Compose et à Django local.
POSTGRES_DB=cafe_dolbeau
POSTGRES_USER=cafe_dolbeau
# Mot de passe de démonstration : choisissez votre valeur dans .env.
POSTGRES_PASSWORD=cafe-dolbeau-dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# PostgreSQL est la base par défaut. sqlite sert aux anciens scripts et exports.
CAFE_DB_ENGINE=postgresql
