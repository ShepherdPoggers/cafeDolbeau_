# Copier dans .env, puis lancer docker compose up --build depuis la racine.
# Compose trouve sa configuration dans docker/ grâce à cette variable.

COMPOSE_FILE=docker/compose.yaml

# Si vides, ces secrets sont générés au démarrage dans un volume persistant.
# Pour une base existante, conserver son mot de passe et la clé actuels.
SECRET_KEY=
POSTGRES_PASSWORD=

# Base PostgreSQL persistante. Dans Compose, l’hôte interne est toujours db.
POSTGRES_DB=cafe_dolbeau
POSTGRES_USER=cafe_dolbeau
POSTGRES_HOST=db
POSTGRES_PORT=5432
CAFE_DB_ENGINE=postgresql

# Cloudflare Tunnel : renseigner le jeton uniquement dans .env, jamais dans Git.
# Route publique : cafe.example.com -> http://proxy:8080.
# Remplacer cafe.example.com par votre domaine dans .env.
CLOUDFLARE_TUNNEL_TOKEN=
# Seul nginx publie un port local sur la VM ; cloudflared utilise le réseau Docker.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8000
# Mettre https uniquement si une terminaison TLS protège le proxy.
PUBLIC_SCHEME=https
# Listes séparées par des virgules, sans schéma pour les hôtes, avec schéma/port pour CSRF.
# Le premier hôte sert aussi aux contrôles de santé internes.
DJANGO_ALLOWED_HOSTS=cafe.example.com,localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=https://cafe.example.com

# HTTPS public terminé par Cloudflare ; HTTP interne entre cloudflared et nginx.
# Garder la redirection désactivée pour les contrôles de santé HTTP internes.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30

# Développement local uniquement : docker/compose.dev.yaml et config.settings_development.
POSTGRES_DEV_PORT=5432
# DJANGO_DEBUG=true
# DJANGO_SETTINGS_MODULE=config.settings_development
# CAFE_DB_PATH=src/db.sqlite3
