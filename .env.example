# Copier dans .env, puis exécuter python scripts/configurer_env.py.
# Ce script remplit uniquement les secrets vides, sans afficher leurs valeurs.
SECRET_KEY=
POSTGRES_PASSWORD=

# Base PostgreSQL persistante. Dans Compose, l’hôte interne est toujours db.
POSTGRES_DB=cafe_dolbeau
POSTGRES_USER=cafe_dolbeau
POSTGRES_HOST=db
POSTGRES_PORT=5432
CAFE_DB_ENGINE=postgresql

# Seul nginx publie un port sur l’ordinateur.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8000
# Mettre https uniquement si une terminaison TLS protège le proxy.
PUBLIC_SCHEME=http
# Listes séparées par des virgules, sans schéma pour les hôtes, avec schéma/port pour CSRF.
# Le premier hôte sert aussi aux contrôles de santé internes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# HTTP local pour la correction. Activer ces options uniquement derrière HTTPS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30

# Développement local uniquement : compose.dev.yaml et config.settings_development.
POSTGRES_DEV_PORT=5432
# DJANGO_DEBUG=true
# DJANGO_SETTINGS_MODULE=config.settings_development
# CAFE_DB_PATH=src/db.sqlite3
